[Unit]
Description=OMS project-storage claim-tag print daemon (Epson TM via ESC/POS to USB)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Override these with EnvironmentFile=/etc/oms-claim-print.env on the Pi
# so secrets and per-site config stay out of the unit file.
Environment=OMS_API_BASE=https://oms.example.com/api
Environment=OMS_POLL_INTERVAL_S=10
# ESC/POS is written straight to the printer's USB character device.
# Defaults: /dev/usb/lp0, 576 dots (80mm; use 512 for 58mm), partial-cut on.
# Environment=OMS_ESCPOS_DEVICE=/dev/usb/lp0
# Environment=OMS_ESCPOS_WIDTH_DOTS=576
# Environment=OMS_ESCPOS_CUT=true
# Bearer token: only needed if the deployment has gated the print-queue
# endpoint behind auth (default OMS endpoints are AllowAny on the Pi side).
# Environment=OMS_API_TOKEN=

User=pi
# usblp nodes are typically root:lp mode 0660, so the service needs the lp
# group to open /dev/usb/lp0 for writing. Drop this if your udev rule grants
# access another way (e.g. a uaccess tag).
SupplementaryGroups=lp
WorkingDirectory=/opt/oms-claim-print
ExecStart=/opt/oms-claim-print/oms-claim-print

# Restart on crash but back off so a misconfigured printer can't pin a CPU
Restart=on-failure
RestartSec=15s

# Hardening — the daemon only needs network out + the USB printer device.
# ProtectSystem=strict leaves /dev alone, so writing the usblp node needs no
# ReadWritePaths; PrivateDevices stays off so /dev/usb/lp0 remains visible.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
